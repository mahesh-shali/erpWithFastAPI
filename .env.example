# ---- DEVELOPMENT / TESTING template ----
# cp .env.example .env.development   then fill in. Never put real secrets in this file.
# (Production template: .env.production.example)

APP_ENV=development
ASPNETCORE_ENVIRONMENT=Development
SEED_DEMO_DATA=true                 # demo tenants + admin@demo.com / Admin@123
CORS_ORIGINS=http://localhost:5173,http://localhost
HTTP_PORT=80

# ---- PostgreSQL ----
# Option A (default): local Postgres container. Keep COMPOSE_PROFILES=localdb.
# Option B: managed Postgres (e.g. Aiven). Set COMPOSE_PROFILES= (empty) and fill in
#           host/port/db/user/password from the provider, with POSTGRES_SSLMODE=require.
COMPOSE_PROFILES=localdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=erp
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=erp_app_dev
POSTGRES_SSLMODE=disable

# Replicas and connection pools (per pod). Keep the total below the server's max_connections.
API_REPLICAS=2
AI_REPLICAS=2
API_DB_POOL_SIZE=100
DB_POOL_MIN=2
DB_POOL_MAX=20
AI_WORKERS=4                        # AI service workers x DB_POOL_MAX = its DB connections

# Read-only AI login. Use erp_ai_ro on a server only this environment uses;
# use a per-environment name (erp_ai_ro_dev, erp_ai_ro_prod) when environments share a server.
AI_DB_USER=erp_ai_ro
AI_DB_PASSWORD=ai_readonly_dev

# Shared JWT settings (ASP.NET Core issues, FastAPI validates). Must be >= 32 bytes.
JWT_SECRET=change-me-to-a-random-256-bit-secret-value-0123456789
JWT_ISSUER=erp-api
JWT_AUDIENCE=erp-clients

# LLM: Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

REDIS_URL=redis://redis:6379/0
# Optional managed Redis for the API, e.g. Upstash (leave unset for the local container):
# API_REDIS_CONNECTION=<endpoint>:6379,password=<password>,ssl=True,abortConnect=False
