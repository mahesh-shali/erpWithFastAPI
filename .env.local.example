# ---- LOCAL template: everything on this machine (Postgres, Redis, app, nginx, Prometheus, Grafana, k6) ----
# ./local.sh up copies this to .env.local on first run. Nothing here points at a cloud service.
# Use with:  docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.local.yml ...
# (local.sh does that for you)

APP_ENV=local                       # compose project "erp-local": own containers + volumes
# Production code paths (Release build, no Swagger, prod logging levels), but with demo data
# and load-test-friendly limits. The API refuses demo seed data when ASPNETCORE_ENVIRONMENT=Production,
# so this uses Staging, which behaves like Production everywhere else.
ASPNETCORE_ENVIRONMENT=Staging
SEED_DEMO_DATA=true                 # demo tenants + admin@demo.com / Admin@123
CORS_ORIGINS=http://localhost:8088,http://localhost:5173
HTTP_PORT=8088                      # app via nginx: http://localhost:8088

# ---- PostgreSQL: local container ----
COMPOSE_PROFILES=localdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=erp
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=erp_app_local
POSTGRES_SSLMODE=disable
LOCAL_PG_PORT=5434                  # host port for psql / pgAdmin: localhost:5434 (5432/5433 are often a native Postgres)

# Replicas and pools (per container). Total DB connections = API_REPLICAS*API_DB_POOL_SIZE
#   + AI_REPLICAS*AI_WORKERS*DB_POOL_MAX + exporters; keep it under Postgres max_connections (500).
API_REPLICAS=2
AI_REPLICAS=1
API_DB_POOL_SIZE=100
DB_POOL_MIN=2
DB_POOL_MAX=10
AI_WORKERS=2

AI_DB_USER=erp_ai_ro
AI_DB_PASSWORD=ai_readonly_local

# Local-only secret (>= 32 bytes). Never reuse in production.
JWT_SECRET=local-only-jwt-secret-not-for-production-0123456789abcdef
JWT_ISSUER=erp-api
JWT_AUDIENCE=erp-clients

# LLM (only /ai/chat needs it). local.sh copies GROQ_API_KEY from .env.development if this is empty.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local Redis container (compose service `redis`). Leave API_REDIS_CONNECTION unset => redis:6379.
REDIS_URL=redis://redis:6379/0

# ---- Load-test limits (local only) ----
# All k6 virtual users share one IP, so production's per-IP limits would make k6 measure 429s.
RATE_LIMIT_PER_USER_PER_SECOND=1000
RATE_LIMIT_PER_USER_BURST=2000
RATE_LIMIT_AUTH_PER_MINUTE=100000
ACCESS_TOKEN_MINUTES=240            # longer than the longest k6 profile

# ---- Observability ----
GRAFANA_PORT=3000                   # http://localhost:3000 (anonymous admin, local only)
PROMETHEUS_PORT=9090                # http://localhost:9090
