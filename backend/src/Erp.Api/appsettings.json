{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=erp;Username=erp_app;Password=erp_app_dev;Maximum Pool Size=100",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "change-me-to-a-random-256-bit-secret-value-0123456789",
    "Issuer": "erp-api",
    "Audience": "erp-clients",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "SessionDays": 14,
    "CookieName": "erp_refresh",
    "ActiveCheckCacheSeconds": 30,
    "RetainEndedSessionsDays": 30
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Cors": { "Origins": [ "http://localhost:5173", "http://localhost" ] },
  "Kestrel": {
    "Limits": { "MaxConcurrentConnections": 10000, "MaxRequestBodySize": 1048576 }
  }
}
