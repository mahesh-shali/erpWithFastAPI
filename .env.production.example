# ---- PRODUCTION template ----
# cp .env.production.example .env.production   then fill in EVERY value. Never commit .env.production.
# The API and AI service refuse to start in production with placeholder secrets or demo seeding.

APP_ENV=production
ASPNETCORE_ENVIRONMENT=Production
SEED_DEMO_DATA=false
CORS_ORIGINS=https://erp.example.com      # your public URL(s), comma-separated
HTTP_PORT=80

# ---- PostgreSQL (managed, TLS) ----
COMPOSE_PROFILES=                          # never run the local postgres container in production
POSTGRES_HOST=<host>
POSTGRES_PORT=<port>
POSTGRES_DB=erp_prod
POSTGRES_USER=<admin user>
POSTGRES_PASSWORD=<password>
POSTGRES_SSLMODE=require

# Replicas x pool size must stay below max_connections (minus any other environment on the server)
API_REPLICAS=2
AI_REPLICAS=2
API_DB_POOL_SIZE=3
DB_POOL_MIN=1
DB_POOL_MAX=2
AI_WORKERS=1                        # AI service workers x DB_POOL_MAX = its DB connections

# Read-only AI login — unique to production
AI_DB_USER=erp_ai_ro_prod
AI_DB_PASSWORD=<random: python -c "import secrets;print(secrets.token_urlsafe(24))">

# Must differ from development. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<random, >= 32 bytes>
JWT_ISSUER=erp-api
JWT_AUDIENCE=erp-clients

GROQ_API_KEY=<production Groq key>
GROQ_MODEL=openai/gpt-oss-120b

REDIS_URL=redis://redis:6379/0
# Optional managed Redis for the API, e.g. Upstash (leave unset for the local container):
# API_REDIS_CONNECTION=<endpoint>:6379,password=<password>,ssl=True,abortConnect=False
